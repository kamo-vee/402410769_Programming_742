@model HostApplicationViewModel
@{ ViewData["Title"] = "Become a host"; }
<section class="panel form-panel">
    <p class="eyebrow">@(User.IsInRole("Host") ? "Add a property" : "Become a host")</p><h1>Tell us about your place</h1>
    <p>Your listing stays hidden until an administrator reviews it. Approval changes Guest applicants to Host; existing Hosts keep their Host role.</p>
    <form asp-action="@(User.IsInRole("Host") ? "CreateAdditional" : "Create")" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation"></div>
        <label asp-for="Title">Property title</label><input asp-for="Title" />
        <label asp-for="Description">Description</label><textarea asp-for="Description" rows="5"></textarea>
        <div class="form-row">
            <div><label asp-for="PricePerNight">Price per night (R)</label><input asp-for="PricePerNight" type="number" step="0.01" min="1" /></div>
            <div><label asp-for="MaxGuests">Maximum guests</label><input asp-for="MaxGuests" type="number" min="1" max="20" /></div>
        </div>
        <label asp-for="Address">Street address</label><input asp-for="Address" />
        <div class="form-row">
            <div><label asp-for="City">City</label><input asp-for="City" /></div>
            <div><label asp-for="PropertyType">Property type</label><select asp-for="PropertyType"><option>Apartment</option><option>House</option><option>Cabin</option><option>Guesthouse</option><option>Villa</option></select></div>
        </div>
        <label asp-for="Images">Property images (at least one required)</label><input asp-for="Images" type="file" multiple accept=".jpg,.jpeg,.png,.webp" />
        <p class="muted">1–8 JPG, PNG, or WEBP images. Maximum 5 MB each, 20 MB combined. Documents are uploaded separately during check-in.</p>
        <button type="submit">Submit for review</button>
    </form>
</section>
