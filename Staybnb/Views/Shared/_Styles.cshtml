<style>
:root{--pink:#e83f62;--ink:#242429;--muted:#6e6d75;--border:#e8e5e6;--background:#faf9f7;--radius:16px}
*{box-sizing:border-box}body{margin:0;color:var(--ink);font-family:Segoe UI,Arial,sans-serif;background:var(--background);line-height:1.6}a{color:var(--pink);text-decoration:none}a:hover{text-decoration:underline}h1,h2,h3{line-height:1.2;letter-spacing:-.025em}h1{font-size:clamp(2rem,4vw,3.3rem);margin:12px 0 22px}h2{font-size:1.5rem}h3{font-size:1.13rem}p{margin:10px 0 18px}small,.muted{color:var(--muted)}.site-header{padding:24px 5%;background:white;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:25px;flex-wrap:wrap}.brand{font-size:2rem;font-weight:800;letter-spacing:-.06em}.brand span{display:block;font-size:.65rem;font-weight:500;letter-spacing:.1em;color:var(--muted)}nav{display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:.88rem}nav a{color:var(--ink)}.container{max-width:1250px;margin:auto;padding:30px 28px 70px;min-height:75vh}.hero{padding:40px 0 15px}.hero h1{font-size:clamp(2.8rem,6vw,5rem);max-width:800px;letter-spacing:-.06em}.hero p{max-width:560px}.eyebrow{text-transform:uppercase;font-size:.76rem;letter-spacing:.15em;font-weight:700;color:var(--pink)}button,.button{border:0;border-radius:10px;background:var(--pink);color:white;padding:13px 22px;display:inline-block;font:600 .9rem Segoe UI,Arial,sans-serif;cursor:pointer;text-align:center}button:hover,.button:hover{background:#c93151;text-decoration:none}.secondary{background:#f1eef0;color:var(--ink)}.secondary:hover{background:#e6dfe3}.danger{background:#9d3245}.small{padding:9px 15px;font-size:.8rem}.link-button{padding:0;background:none;color:var(--pink)}.link-button:hover{background:none;text-decoration:underline}.inline{display:inline}.badge{background:var(--pink);color:white;padding:2px 7px;border-radius:20px;font-size:.72rem}.search-bar{display:flex;gap:20px;align-items:end;background:white;padding:22px;border:1px solid var(--border);border-radius:var(--radius);margin:20px 0 40px}.search-bar>div{flex:1}.search-bar input,.search-bar select{margin-bottom:0}.search-bar>a{padding-bottom:10px;white-space:nowrap}.section-heading,.row-between{display:flex;align-items:center;justify-content:space-between;gap:20px}.section-heading{margin:26px 0}.property-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.property-card{background:white;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border)}.property-card>a{color:inherit}.property-card img{width:100%;height:235px;object-fit:cover}.card-body{padding:20px}.card-body h3{margin:6px 0}.card-body p{margin:8px 0}.panel{background:white;border:1px solid var(--border);padding:28px;border-radius:var(--radius);margin-bottom:22px}.narrow{max-width:480px;margin:25px auto}.form-panel{max-width:760px;margin:20px auto}.empty{padding:45px;background:white;border:1px dashed #c9c3c6;border-radius:var(--radius);text-align:center;color:var(--muted);margin:20px 0}label{display:block;font-size:.9rem;font-weight:600;margin:12px 0 5px}input,select,textarea{width:100%;padding:12px;border:1px solid #d5d0d3;border-radius:8px;font:inherit;color:var(--ink);background:white;margin-bottom:12px}input:focus,select:focus,textarea:focus{outline:2px solid #f4acc0;outline-offset:1px}input[type=checkbox]{width:auto;margin:0 10px 0 0}.checkbox{display:flex;align-items:center;margin-bottom:20px}.form-row{display:flex;gap:22px}.form-row>div{flex:1}.actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:18px 0}.two-column{display:grid;grid-template-columns:1.6fr 1fr;gap:35px;align-items:start}.image-gallery{display:flex;gap:14px;overflow-x:auto;margin:25px 0 40px}.image-gallery img{height:330px;max-width:75%;object-fit:cover;border-radius:var(--radius)}.booking-summary{position:sticky;top:20px}.booking-summary small{font-size:.9rem;font-weight:normal}.preserve-lines{white-space:pre-line}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.metrics .panel{display:flex;flex-direction:column}.metrics strong{font-size:2.7rem}.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:white;margin-bottom:24px}table{border-collapse:collapse;width:100%;font-size:.88rem}td,th{padding:15px;text-align:left;border-bottom:1px solid var(--border)}th{background:#f2eef0}td form{margin:0}.status,.tags span{display:inline-block;background:#f5eef1;padding:5px 11px;border-radius:7px;font-size:.79rem;font-weight:600}.tags{display:flex;gap:12px;flex-wrap:wrap}.listing-row{display:flex;gap:30px;align-items:center}.listing-row>img{width:200px;height:160px;object-fit:cover;border-radius:12px}.document-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--border)}.alert{padding:16px 22px;border-radius:10px;margin:0 0 25px}.success{background:#e3f4e9;color:#245b37}.error,.validation{background:#fff0f2;color:#a12540}.validation:empty{display:none}.validation{padding:8px 14px;margin-bottom:16px}.success-text{color:#287b45}.thread{display:flex;flex-direction:column;gap:15px;margin:25px 0}.message{padding:18px 22px;border-radius:16px;max-width:80%;background:white;border:1px solid var(--border)}.message p{white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 8px}.sent{align-self:flex-end;background:#fff0f4}.received{align-self:flex-start}footer{text-align:center;border-top:1px solid var(--border);padding:25px;font-size:.8rem;color:var(--muted)}hr{border:0;border-top:1px solid var(--border);margin:24px 0}
@@media(max-width:850px){.property-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-column{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.booking-summary{position:static}.site-header{padding:18px 25px}nav{gap:12px}.search-bar{flex-wrap:wrap}}
@@media(max-width:550px){.property-grid,.metrics{grid-template-columns:1fr}.listing-row{flex-direction:column;align-items:start}.listing-row>img{width:100%}.form-row{display:block}.search-bar{display:block}.search-bar button{width:100%;margin:10px 0}.container{padding:25px 16px 50px}.panel{padding:21px}.row-between,.section-heading{align-items:start;flex-direction:column}.hero{padding-top:20px}.image-gallery img{height:240px}.message{max-width:95%}}
</style>
