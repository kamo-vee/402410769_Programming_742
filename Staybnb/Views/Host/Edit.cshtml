@model PropertyEditViewModel
@{ ViewData["Title"] = "Edit listing"; }
<section class="panel form-panel"><h1>Edit listing</h1><form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden" />
    <label asp-for="Title"></label><input asp-for="Title" />
    <label asp-for="Description"></label><textarea asp-for="Description" rows="6"></textarea>
    <label asp-for="PricePerNight">Price per night (R)</label><input asp-for="PricePerNight" type="number" step="0.01" />
    <label asp-for="CleaningFee">Cleaning fee (R)</label><input asp-for="CleaningFee" type="number" step="0.01" />
    <label asp-for="MaxGuests">Maximum guests</label><input asp-for="MaxGuests" type="number" min="1" max="20" />
    <button>Save changes</button>
</form></section>
