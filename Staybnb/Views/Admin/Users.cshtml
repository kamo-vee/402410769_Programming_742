@model List<ApplicationUser>
@{ ViewData["Title"] = "User management"; }
<h1>Promote a Guest to Admin</h1><p>Only the seeded SuperAdmin can perform this action. The Guest role is removed when Admin access is granted.</p>
<form asp-action="Users" method="get" class="search-bar"><input name="search" value="@ViewBag.Search" placeholder="Search email or name" aria-label="Search guests" /><button>Search</button></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Action</th></tr></thead><tbody>
@foreach (var user in Model)
{
    <tr><td>@user.FirstName @user.LastName</td><td>@user.Email</td><td><form asp-action="PromoteGuest" method="post"><input type="hidden" name="userId" value="@user.Id" /><button class="small">Promote to Admin</button></form></td></tr>
}
</tbody></table></div><p class="muted">Shows up to 100 matching Guest accounts.</p>
