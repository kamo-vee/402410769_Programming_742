@model List<ActivityLog>
@{ ViewData["Title"] = "Activity log"; int page = ViewBag.Page; }
<p class="eyebrow">System audit</p><h1>Activity log</h1>
<div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>User</th><th>Type</th><th>Action</th></tr></thead><tbody>
@foreach (var log in Model) { <tr><td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@log.User?.Email</td><td>@log.ActivityType</td><td>@log.Action</td></tr> }
</tbody></table></div>
<div class="actions">@if (page > 1) { <a asp-action="Logs" asp-route-page="@(page - 1)">Previous</a> } <span>Page @(page)</span> @if (Model.Count == 50) { <a asp-action="Logs" asp-route-page="@(page + 1)">Next</a> }</div>
